{
  "name": "PS5 WebKit Autoloader",
  "version": "0.6.1",
  "new_install_prompt_erase": true,
  "new_install_improv_wait_time": 0,
  "builds": [
    {
      "chipFamily": "ESP32",
      "parts": [{ "path": "firmware/esp32-arduino.pico.merged.bin", "offset": 0 }]
    },
    {
      "chipFamily": "ESP32-S2",
      "parts": [{ "path": "firmware/esp32-arduino.s2.merged.bin", "offset": 0 }]
    },
    {
      "chipFamily": "ESP32-S3",
      "parts": [{ "path": "firmware/esp32-arduino.s3.merged.bin", "offset": 0 }]
    },
    {
      "chipFamily": "ESP32-C3",
      "parts": [{ "path": "firmware/esp32-arduino.c3.merged.bin", "offset": 0 }]
    }
  ]
}
